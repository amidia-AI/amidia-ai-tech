rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Strict helper to enforce only the single authorized user ss3825424@gmail.com can administer or read private records
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email != null &&
             request.auth.token.email.toLowerCase() == 'ss3825424@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile documents - strictly restricted to the authorized administrator
    match /users/{userId} {
      allow read, write: if isAdmin();

      match /progress/{contentId} {
        allow read, write: if isAdmin();
      }
    }

    // Content collection (publicly readable technical content, written only by verified admin)
    match /content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public Media Kit Submissions (public create, read/manage by verified admin only)
    match /kit_submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Brand Media Kit Tokens: a single token can be fetched by whoever holds its id,
    // but the collection must never be listable or every sponsor link would be exposed.
    match /kit_tokens/{tokenId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Kit View Audit Logs
    match /kit_views/{viewId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Studio Screenshot Proofs
    match /studio_screenshots/{screenshotId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Video Ideas / Upcoming Topics (public read for gated kit scoping, write by admin only)
    match /video_ideas/{ideaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
